{
  "dataset": "cifar10",
  "encoder_arch": "vit_b_16",
  "encoder_weights": "imagenet",
  "freeze_encoder": true,
  "feature_cache": true,
  "feature_cache_dir": "results/feature_cache/cifar10_vit_b16",
  "epochs": 15,
  "feature_dim": 768,
  "expert_hidden": 512,
  "proto_size": 1000,
  "num_workers": 8,
  "methods": "naive,ewc,replay250,derpp,icarl,palmoe,hybrid",
  "trigger": "always",
  "expand_every_task": true,
  "max_experts": 5,
  "proto_routing_alpha": 0.0,
  "router_type": "dynamic",
  "lambda_ood": 0.1,
  "joint_calib_epochs": 10,
  "refresh_anchors_after_calib": true,
  "router_anchor_steps": 300,
  "router_anchor_lr": 0.001,
  "max_proto_drop": 999.0,
  "max_proto_acc_drop": 999.0,
  "joint_freeze_router": false,
  "anchor": false,
  "gate_mode": "relative",
  "gate_margin": 0.1
}
